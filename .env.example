DATABASE_URL=postgresql://aayatra:aayatra_dev_only@localhost:55432/aayatra_sales
APP_ORIGIN=http://localhost:3000
BOOTSTRAP_EMAIL=owner@aayatra.local
BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
# Comma-separated exact hostnames of approved DEMO/STAGING targets; empty means no live demo visits.
DEMO_ALLOWED_HOSTS=
# Optional local Chromium/Chrome executable for read-only demo health checks.
# CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# Test-only signed inbound webhook. Keep false outside an isolated test environment.
ALLOW_TEST_WEBHOOKS=false
# Set only in isolated tests when ALLOW_TEST_WEBHOOKS=true; never commit a real secret.
INBOUND_TEST_WEBHOOK_SECRET=
# Optional: Claude drafting layered on the grounded templates (drafts still need human approval).
# AI_REPLY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_REPLY_MODEL=claude-opus-5-5
# WhatsApp Cloud API secrets: store values here (or your secret manager) and enter only the
# variable NAMES in Settings → WhatsApp. Production stays NOT_CONFIGURED until all are set.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Simulated provider for local testing only; it never marks anything as delivered.
MESSAGING_TEST_PROVIDER=false
# Demo targets (empty = WAITING_FOR_DEMO_URL). Also add each host to DEMO_ALLOWED_HOSTS.
AADHAR_RESTAURANT_DEMO_URL=
AADHAR_RETAIL_DEMO_URL=
AADHAR_HOTEL_DEMO_URL=
AADHAR_HOTEL_RESTAURANT_DEMO_URL=
THE_HAIRCUT_DEMO_URL=
# Where uploaded registration documents and demo recordings are stored (outside the web root).
# DOCUMENT_STORAGE_DIR=./storage/documents
# DEMO_OUTPUT_DIR=./storage/demo
# FFMPEG_PATH=ffmpeg
